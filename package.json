{
  "name": "mcp-vitest-docs",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "types:check": "next typegen && tsc --noEmit",
    "format": "prettier --write \"{app,components,lib,scripts}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{app,components,lib,scripts}/**/*.{ts,tsx,css}\"",
    "check:samples": "tsx scripts/check-samples.ts && tsc -p tsconfig.samples.json",
    "check:routes": "node scripts/check-routes.mjs",
    "check:vitals": "node scripts/check-vitals.mjs",
    "check:spell": "cspell --no-progress \"**/*.{ts,tsx,mjs,css,md,mdx,json}\""
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "cnfast": "0.2.0",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cspell": "10.5.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "mcp-vitest": "0.5.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
