{
  "name": "mcp-vitest-docs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "types:check": "next typegen && tsc --noEmit",
    "format": "prettier --write \"{app,components,lib,scripts}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{app,components,lib,scripts}/**/*.{ts,tsx,css}\"",
    "check:samples": "tsx scripts/check-samples.ts && tsc -p tsconfig.samples.json",
    "check:routes": "node scripts/check-routes.mjs",
    "check:vitals": "node scripts/check-vitals.mjs",
    "check:spell": "cspell --no-progress \"**/*.{ts,tsx,mjs,css,md,mdx,json}\""
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.14.2",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cspell": "^8.19.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "mcp-vitest": "^0.5.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
